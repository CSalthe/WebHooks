{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false },
  "projects": { "playground": { "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": { "builder": "@angular/build:application", "options": { "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "outputPath": "dist/playground" }, "configurations": { "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }] } }, "defaultConfiguration": "production" },
      "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "playground:build", "port": 4200 } }
    }
  } }
}
